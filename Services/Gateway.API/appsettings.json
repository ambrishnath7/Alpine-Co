{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/products"
        }
      },
      "products-sub-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "images-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/images/{**catch-all}"
        }
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/api/basket"
        }
      },
      "basket-sub-route": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/api/basket/{**catch-all}"
        }
      },
      "account-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/account/{**catch-all}"
        }
      },
      "login-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/login"
        }
      },
      "manage-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/manage/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/orders"
        }
      },
      "orders-sub-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/payments"
        }
      },
      "payments-sub-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "fallback-api-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004"
          }
        }
      }
    }
  }
}